# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/notes-api
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/notes-api

# Cookie / Session secret (use a long random string)
COOKIE_SECRET=your_super_secret_cookie_key_change_this_in_production

# Cloudinary (get these from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
